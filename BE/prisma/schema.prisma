// MoneyMate - Prisma schema
// Sumber kebenaran struktur database. Nama tabel & kolom sengaja dipetakan
// persis seperti database MySQL lama (snake_case) agar query mentah yang masih
// berjalan lewat mysql2 tetap kompatibel selama masa transisi.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  student
  admin
}

enum CategoryType {
  income
  expense
}

enum TransactionType {
  income
  expense
}

enum ReportType {
  monthly
  weekly
  custom
  annual
}

enum CurrencyType {
  IDR
  USD
}

enum Language {
  id
  en
}

enum Theme {
  light
  dark
}

// ============================================
// 1. USERS
// ============================================

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique(map: "email") @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  password  String   @db.VarChar(255)
  avatarUrl String?  @map("avatar_url") @db.VarChar(255)
  role      Role     @default(student)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  incomeSources    IncomeSource[]
  transactions     Transaction[]
  budgets          Budget[]
  goals            Goal[]
  goalFunds        GoalFund[]
  aiInsights       AiInsight[]
  notifications    Notification[]
  reports          Report[]       @relation("ReportUser")
  generatedReports Report[]       @relation("ReportGenerator")
  settings         UserSetting?
  auditLogs        AuditLog[]
  wallets          Wallet[]

  @@map("users")
}

// ============================================
// 2. CATEGORIES
// ============================================

model Category {
  id        Int          @id @default(autoincrement())
  name      String       @db.VarChar(50)
  type      CategoryType
  icon      String?      @db.VarChar(50)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamp(0)

  transactions Transaction[]
  budgets      Budget[]

  @@map("categories")
}

// ============================================
// 3. INCOME SOURCES
// ============================================

model IncomeSource {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  sourceName String   @map("source_name") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("income_sources")
}

// ============================================
// 4. WALLETS
// ============================================

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String   @db.VarChar(100)
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("IDR") @db.VarChar(10)
  isDefault Boolean? @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_wallets_user")
  @@map("wallets")
}

// ============================================
// 5. TRANSACTIONS
// ============================================

model Transaction {
  id              Int             @id @default(autoincrement())
  userId          Int             @map("user_id")
  type            TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  categoryId      Int             @map("category_id")
  incomeSourceId  Int?            @map("income_source_id")
  date            DateTime        @db.Date
  note            String?         @db.Text
  receiptImageUrl String?         @map("receipt_image_url") @db.VarChar(255)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamp(0)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id])
  incomeSource IncomeSource? @relation(fields: [incomeSourceId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_transactions_user")
  @@index([date], map: "idx_transactions_date")
  @@index([type], map: "idx_transactions_type")
  @@map("transactions")
}

// ============================================
// 6. BUDGETS
// ============================================

model Budget {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  categoryId Int      @map("category_id")
  amount     Decimal  @db.Decimal(12, 2)
  month      Int
  year       Int
  isActive   Boolean? @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month, year], map: "unique_budget")
  @@map("budgets")
}

// ============================================
// 7. GOALS
// ============================================

model Goal {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  title         String    @db.VarChar(100)
  targetAmount  Decimal   @map("target_amount") @db.Decimal(12, 2)
  currentAmount Decimal?  @default(0) @map("current_amount") @db.Decimal(12, 2)
  icon          String?   @db.VarChar(50)
  deadline      DateTime? @db.Date
  isCompleted   Boolean?  @default(false) @map("is_completed")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalFunds GoalFund[]

  @@map("goals")
}

// ============================================
// 8. GOAL FUNDS
// ============================================

model GoalFund {
  id        Int      @id @default(autoincrement())
  goalId    Int      @map("goal_id")
  userId    Int      @map("user_id")
  amount    Decimal  @db.Decimal(12, 2)
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goal_funds")
}

// ============================================
// 9. AI INSIGHTS
// ============================================

model AiInsight {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  insightType String   @map("insight_type") @db.VarChar(50)
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_insights")
}

// ============================================
// 10. NOTIFICATIONS
// ============================================

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(100)
  message   String?  @db.Text
  isRead    Boolean? @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_notifications_user")
  @@map("notifications")
}

// ============================================
// 11. REPORTS
// ============================================

model Report {
  id          Int        @id @default(autoincrement())
  userId      Int?       @map("user_id")
  generatedBy Int        @map("generated_by")
  reportType  ReportType @map("report_type")
  title       String?    @db.VarChar(150)
  periodStart DateTime?  @map("period_start") @db.Date
  periodEnd   DateTime?  @map("period_end") @db.Date
  fileUrl     String?    @map("file_url") @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp(0)

  user            User? @relation("ReportUser", fields: [userId], references: [id], onDelete: SetNull)
  generatedByUser User  @relation("ReportGenerator", fields: [generatedBy], references: [id])

  @@map("reports")
}

// ============================================
// 12. USER SETTINGS
// ============================================

model UserSetting {
  id                  Int          @id @default(autoincrement())
  userId              Int          @unique(map: "user_id") @map("user_id")
  currency            CurrencyType @default(IDR)
  language            Language     @default(id)
  theme               Theme        @default(light)
  notificationEnabled Boolean?     @default(true) @map("notification_enabled")
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ============================================
// 13. AUDIT LOGS
// ============================================

model AuditLog {
  id          Int      @id @default(autoincrement())
  adminId     Int      @map("admin_id")
  action      String   @db.VarChar(100)
  targetTable String?  @map("target_table") @db.VarChar(50)
  targetId    Int?     @map("target_id")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId], map: "idx_audit_admin")
  @@index([action], map: "idx_audit_action")
  @@map("audit_logs")
}
