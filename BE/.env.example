# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Dipakai Prisma (client, migrate, studio)
DATABASE_URL="mysql://root:@localhost:3306/moneymate_db"

# Dipakai kode lama (mysql2) selama masa transisi raw query -> Prisma
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=moneymate_db
DB_PORT=3306

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=
