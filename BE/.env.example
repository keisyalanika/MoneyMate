# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Dipakai Prisma (client, migrate, studio)
DATABASE_URL="mysql://root:@localhost:3306/moneymate_db"

# Dipakai kode lama (mysql2) selama masa transisi raw query -> Prisma
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=moneymate_db
DB_PORT=3306

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=

# AI Chatbot (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set true untuk memakai fallback mock tanpa memanggil Gemini
AI_MOCK=false

# ─── Email / SMTP untuk OTP ────────────────────────────────────────────────
# true  = tidak mengirim email; OTP hanya tampil di console server (development).
# false = kirim OTP sungguhan lewat SMTP di bawah.
EMAIL_MOCK=true

# Opsi 1: Gmail App Password
# Syarat: 2-Step Verification aktif, lalu buat App Password 16 karakter:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password

# Opsi 2: Mailtrap (opsional, untuk testing)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=<mailtrap_username>
# SMTP_PASS=<mailtrap_password>

# ─── Google OAuth 2.0 (Google Sign-In) ──────────────────────────────────────
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=625929892019-qcj7jq5qksj1devk3sh9ujh0g9h5ot1a.apps.googleusercontent.com