# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Dipakai Prisma (client, migrate, studio)
DATABASE_URL="mysql://root:@localhost:3306/moneymate_db"

# Dipakai kode lama (mysql2) selama masa transisi raw query -> Prisma
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=moneymate_db
DB_PORT=3306

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=

# AI Chatbot (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set true untuk memakai fallback mock tanpa memanggil Gemini
AI_MOCK=false

# ─── Email / SMTP untuk OTP ────────────────────────────────────────────────
# Set EMAIL_MOCK=true untuk menonaktifkan pengiriman email sungguhan.
# OTP akan muncul di console server saja (berguna saat development lokal).
EMAIL_MOCK=true

# --- Opsi 1: Gmail App Password (paling mudah) ---
# 1. Aktifkan 2-Step Verification di akun Google kamu.
# 2. Buka https://myaccount.google.com/apppasswords
# 3. Buat App Password baru (pilih "Mail" + "Other") → salin 16 karakter.
# 4. Isi SMTP_USER dengan email Gmail kamu & SMTP_PASS dengan 16 karakter tadi.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=emailkamu@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# --- Opsi 2: Mailtrap (untuk testing, tidak kirim ke inbox nyata) ---
# Daftar gratis di https://mailtrap.io → Inboxes → SMTP Settings
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=<mailtrap_username>
# SMTP_PASS=<mailtrap_password>

# ─── Google OAuth 2.0 (Google Sign-In) ──────────────────────────────────────
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials
# Buat OAuth 2.0 Client ID (Web Client / Android Client).
# Pisahkan dengan koma jika ada beberapa client ID (misal web + android).
GOOGLE_CLIENT_ID=

